  "pk": "6cab8a31-da85-4b71-a420-789c4ef80076",
  "fields": {
    "name": "chocolate_candy",
    "title": "Chocolate Candy",
    "description": "It was brought over from Poland, and as far as we know, never had a name. We just called it Chocolate Candy, or some people would know it as \"no bake cookies\".",
    "image": "",
    "instructions": "In a medium saucepan, combine the milk, sugar, margarine, and cocoa.\r\nBring the mixture to a boil over medium heat, stirring constantly\r\nOnce it reaches a boil, allow it to boil for 1 minute without stirring.\r\nRemove the saucepan from the heat.\r\nStir in the oatmeal, vanilla, and optional coconut until well combined.\r\nDrop spoonfuls of the mixture onto the prepared wax paper.\r\nAllow the candies to cool and set completely.",
    "tips": "Ensure you do not boil the mixture for more than 1 minute to avoid making the candy too hard.\r\nWork quickly when dropping the candy mixture onto the wax paper as it sets fast.",
    "servings": null,
    "prep_time": null,
