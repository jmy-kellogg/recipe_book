  }
},
{
  "model": "django_app.recipe",
  "pk": "86faa18c-93f6-4a14-9c08-4c316eae3643",
  "fields": {
    "name": "gingersnap_treasures",
    "title": "Gingersnap Treasures",
    "description": "This sweet spiced cookie is perfect for the holidays.",
    "image": "",
    "instructions": "<p><strong>Cookies: </strong></p>\r\n\r\n<p>&nbsp;- Cream butter, sugar, molasses and egg until fluffy</p>\r\n\r\n<p>&nbsp;- Sift four, baking soda, cinnamon, cloves, ginger and salt.</p>\r\n\r\n<p>&nbsp;- Stir into the first mixture until well blended.</p>\r\n\r\n<p>&nbsp;- Shape dough into 1-inch balls and place on ungreased cookie sheet</p>\r\n\r\n<p>&nbsp;- Bake at 375&deg;F for 10 to 12 minutes</p>\r\n\r\n<p>&nbsp;- Let cookies cool completely before apply glaze (see below)</p>\r\n\r\n<p><strong>Glaze:</strong></p>\r\n\r\n<p>&nbsp; - Shift confectioners&#39; sugar</p>\r\n\r\n<p>&nbsp; - Add milk and vanilla</p>\r\n\r\n<p>&nbsp; - Mix together until well blended</p>",
    "tips": "",
    "servings": 50,
    "prep_time": null,
    "cook_time": null,
    "total_time": null,
    "created_at": "2025-01-03T21:06:49.015Z",
