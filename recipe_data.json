  "fields": {
    "name": "steam_custard_eggs",
    "title": "Steam Custard Eggs",
    "description": "Chinese Steamed Egg Custard” or “Dan Ta”, are a traditional Chinese dessert made by steaming eggs with water and seasonings. The result is a delicate, silky, and creamy custard-like texture, often flavored with soy sauce, sesame oil, and sugar.",
    "image": "static/steamed_eggs.jpg",
    "instructions": "- Beat together 1:1 water and eggs\n- Pass through a sieve and pour into a small heat safe bowl\n- Steam for 10-12 mins, then remove from heat.",
    "tips": "If you wish for smaller curds and a smoother texture add more water, up to 1:2 water and egg ratio.",
    "servings": null,
    "prep_time": null,
    "cook_time": null,
    "total_time": null,
    "created_at": "2024-12-21T02:13:24.236Z",
